# 复制为 .env 后修改。以下均为本地演示占位值，不要用于任何真实环境。
POSTGRES_PASSWORD=change-me-postgres
# InfluxDB 3 管理员 token，必须以 apiv3_ 开头；首次启动时写入库中，之后修改需删除 influx3-data 卷（见 README）
INFLUX_TOKEN=apiv3_change-me-influx-token
CONDUIT_ADMIN_USERNAME=admin
CONDUIT_ADMIN_PASSWORD=change-me-admin
CONDUIT_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
CONDUIT_INTERNAL_TOKEN=change-me-internal-token
CONNECTOR_MQTT_USERNAME=conduit-connector
CONNECTOR_MQTT_PASSWORD=change-me-connector
EMQX_DASHBOARD_PASSWORD=change-me-emqx

# 端口绑定地址：默认仅本机可访问；Docker 宿主机是远程机器、或需被其他机器访问时改为 0.0.0.0
BIND_ADDR=127.0.0.1

# 宿主机端口（postgres / redis 不对外暴露）
WEB_PORT=8090
API_PORT=8091
INFLUX_PORT=8096
# PostgreSQL / Redis 对宿主机开放的端口，供 IDE 中运行的服务直连
POSTGRES_PORT=15432
REDIS_PORT=16379
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083

SIM_DEVICE_COUNT=100
SIM_INTERVAL_MS=10000
PIPELINE_CLAIM_MIN_IDLE=60s
