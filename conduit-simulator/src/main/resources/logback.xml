<?xml version="1.0" encoding="UTF-8"?>
<!-- 模拟器日志配置：控制台沿用简洁格式；同时写入 ${CONDUIT_LOG_DIR:-logs}/conduit-simulator.log，
     按天 + 按大小滚动（单文件 50MB、保留 14 天、总量上限 1GB），与 server / transport 的约定一致 -->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${CONDUIT_LOG_DIR:-logs}/conduit-simulator.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${CONDUIT_LOG_DIR:-logs}/conduit-simulator.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>50MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- 级别可用系统属性或环境变量 CONDUIT_LOG_LEVEL 覆盖，本地运行配置设为 DEBUG -->
  <logger name="dev.conduit" level="${CONDUIT_LOG_LEVEL:-INFO}"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
